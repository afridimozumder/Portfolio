---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import { photos } from "../data/photos";
import { site } from "../data/site";

const title = `Photography — ${site.name}`;
const description =
  "A personal photography and travel gallery — Copenhagen and beyond.";

// Pre-generate large renditions for the lightbox (full-size view).
const fulls = await Promise.all(
  photos.map((p) =>
    getImage({ src: p.src, width: 1600, format: "webp", quality: 70 }),
  ),
);
---

<BaseLayout title={title} description={description}>
  <section class="container-page py-[var(--spacing-section)]">
    <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-accent sm:text-sm">
      <span class="h-px w-8 bg-accent"></span>
      Photography
    </p>
    <h1 class="mt-4 text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[-0.015em]">
      Copenhagen & beyond
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
      A personal collection from around the city and my travels. Click any image
      to view it larger.
    </p>

    {/* Masonry grid */}
    <div class="mt-12 gap-4 [column-fill:_balance] columns-2 sm:columns-3 lg:columns-4">
      {
        photos.map((p, i) => (
          <button
            type="button"
            class="lightbox-trigger mb-4 block w-full overflow-hidden rounded-xl border border-edge break-inside-avoid"
            data-full={fulls[i].src}
            data-alt={p.alt}
            aria-label={`View larger: ${p.alt}`}
          >
            <Image
              src={p.src}
              alt={p.alt}
              widths={[300, 500, 700]}
              sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 22vw"
              class="w-full transition-transform duration-500 hover:scale-[1.03]"
              loading="lazy"
            />
          </button>
        ))
      }
    </div>
  </section>

  {/* Lightbox */}
  <div
    id="lightbox"
    class="fixed inset-0 z-50 hidden cursor-zoom-out items-center justify-center bg-black/90 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
  >
    <button
      id="lightbox-close"
      type="button"
      class="absolute right-4 top-4 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 text-white/90 transition-colors hover:bg-white/10"
      aria-label="Close"
    >
      <Icon name="close" class="h-6 w-6" />
    </button>
    <button
      id="lightbox-prev"
      type="button"
      class="absolute left-2 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 text-white/90 transition-colors hover:bg-white/10 sm:left-4"
      aria-label="Previous photo"
    >
      <Icon name="chevron-left" class="h-6 w-6" />
    </button>
    <button
      id="lightbox-next"
      type="button"
      class="absolute right-2 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 text-white/90 transition-colors hover:bg-white/10 sm:right-4"
      aria-label="Next photo"
    >
      <Icon name="chevron-right" class="h-6 w-6" />
    </button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[88vh] max-w-[92vw] rounded-lg object-contain shadow-2xl"
    />
    <p
      id="lightbox-counter"
      class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm tabular-nums text-white/80"
      aria-hidden="true"
    >
    </p>
    <p id="lightbox-live" class="sr-only" aria-live="polite"></p>
  </div>
</BaseLayout>

<script>
  const lb = document.getElementById("lightbox")!;
  const lbImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const counter = document.getElementById("lightbox-counter")!;
  const live = document.getElementById("lightbox-live")!;
  const closeBtn = document.getElementById("lightbox-close")!;
  const prevBtn = document.getElementById("lightbox-prev")!;
  const nextBtn = document.getElementById("lightbox-next")!;

  const triggers = [
    ...document.querySelectorAll<HTMLElement>(".lightbox-trigger"),
  ];
  const items = triggers.map((t) => ({
    full: t.dataset.full!,
    alt: t.dataset.alt ?? "",
  }));

  let index = 0;
  let lastFocused: HTMLElement | null = null;

  const preload = (i: number) => {
    new Image().src = items[(i + items.length) % items.length].full;
  };

  const show = (i: number) => {
    index = (i + items.length) % items.length;
    const item = items[index];
    lbImg.src = item.full;
    lbImg.alt = item.alt;
    counter.textContent = `${index + 1} / ${items.length}`;
    live.textContent = `Photo ${index + 1} of ${items.length}: ${item.alt}`;
    // Warm the neighbours so arrow navigation feels instant.
    preload(index + 1);
    preload(index - 1);
  };

  const isOpen = () => !lb.classList.contains("hidden");

  const open = (i: number, trigger: HTMLElement) => {
    lastFocused = trigger;
    show(i);
    lb.classList.remove("hidden");
    lb.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeBtn.focus();
  };

  const close = () => {
    lb.classList.add("hidden");
    lb.classList.remove("flex");
    lbImg.src = "";
    document.body.style.overflow = "";
    lastFocused?.focus();
  };

  triggers.forEach((t, i) => t.addEventListener("click", () => open(i, t)));

  // A click anywhere in the overlay closes it — except the prev/next controls.
  lb.addEventListener("click", close);
  prevBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    show(index - 1);
  });
  nextBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    show(index + 1);
  });

  document.addEventListener("keydown", (e) => {
    if (!isOpen()) return;
    if (e.key === "Escape") {
      close();
    } else if (e.key === "ArrowLeft") {
      show(index - 1);
    } else if (e.key === "ArrowRight") {
      show(index + 1);
    } else if (e.key === "Tab") {
      // Trap focus inside the dialog while it's open.
      const focusables = [closeBtn, prevBtn, nextBtn];
      const current = focusables.indexOf(document.activeElement as HTMLElement);
      const next = e.shiftKey
        ? current <= 0
          ? focusables.length - 1
          : current - 1
        : current === -1 || current === focusables.length - 1
          ? 0
          : current + 1;
      focusables[next].focus();
      e.preventDefault();
    }
  });
</script>
