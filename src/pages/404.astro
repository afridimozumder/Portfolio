---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon.astro";
import { site } from "../data/site";

const title = `Page not found — ${site.name}`;
const description = "That page doesn't exist — head back to the portfolio.";
---

<BaseLayout title={title} description={description}>
  <section
    class="container-page flex min-h-[60vh] flex-col items-start justify-center py-[var(--spacing-section)]"
  >
    <p
      class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-accent sm:text-sm"
    >
      <span class="h-px w-8 bg-accent"></span>
      404
    </p>
    <h1
      class="mt-6 text-[length:var(--text-h2)] leading-[var(--text-h2--line-height)] tracking-[-0.015em]"
    >
      Page not found
    </h1>
    <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 text-sm font-semibold text-paper shadow-sm transition-all duration-200 hover:bg-accent-strong hover:shadow-md"
      >
        Back to home
      </a>
      <a
        href="/photography"
        class="inline-flex items-center gap-2 rounded-xl border border-edge px-4 py-3 text-sm font-medium text-ink transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        View photography
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
  </section>
</BaseLayout>
