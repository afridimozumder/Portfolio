---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-edge/70">
  <div
    class="container-page flex flex-col gap-3 py-10 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {site.name}</p>
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      <li><a class="transition-colors hover:text-ink" href={`mailto:${site.email}`}>Email</a></li>
      <li><a class="transition-colors hover:text-ink" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a class="transition-colors hover:text-ink" href={site.links.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a class="transition-colors hover:text-ink" href={site.links.instagram} target="_blank" rel="noopener">Instagram</a></li>
    </ul>
  </div>
</footer>
