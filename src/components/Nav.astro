---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/site";

const links = [
  { label: "About", href: "/#about" },
  { label: "Focus", href: "/#focus" },
  { label: "Experience", href: "/#experience" },
  { label: "Projects", href: "/#projects" },
  { label: "Photography", href: "/photography" },
  { label: "Contact", href: "/#contact" },
];
---

<header
  class="sticky top-0 z-40 border-b border-edge/70 bg-paper/85 backdrop-blur-md"
>
  <nav class="container-page flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="font-display text-lg font-medium tracking-tight text-ink"
      aria-label={`${site.name} — home`}
    >
      {site.shortName}<span class="text-accent">.</span>
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-3 py-2 text-sm text-muted transition-colors hover:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
