---
import { Image } from "astro:assets";
import { teaserPhotos } from "../../data/photos";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";

const photos = teaserPhotos.slice(0, 4);
---

{/* Low-emphasis teaser — a quiet grace note that links to the full gallery. */}
<section id="photography-teaser" class="border-t border-edge/60">
  <div class="container-page py-[var(--spacing-section)]">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading eyebrow="Beyond work" title="Photography & travel" />
      <a
        href="/photography"
        class="group inline-flex items-center gap-1.5 text-sm font-medium text-accent transition-colors hover:text-accent-strong"
      >
        View gallery
        <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>

    <div class="mt-9 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        photos.map((p) => (
          <a
            href="/photography"
            class="group block overflow-hidden rounded-xl border border-edge"
            aria-label="Open the photography gallery"
          >
            <Image
              src={p.src}
              alt={p.alt}
              widths={[300, 500, 700]}
              sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 22vw"
              class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
