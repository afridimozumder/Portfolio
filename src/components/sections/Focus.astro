---
import SectionHeading from "../ui/SectionHeading.astro";
import { focus } from "../../data/profile";
---

{/* High-emphasis credibility section — the thesis is the headline signal. */}
<section id="focus" class="border-t border-edge/60">
  <div class="container-page py-[var(--spacing-section)]">
    <SectionHeading eyebrow="Focus" title="What I work toward" />
    <p
      class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl"
    >
      {focus.intro}
    </p>

    <div
      class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,0.56fr)_minmax(0,0.44fr)] lg:gap-8"
    >
      {/* Featured thesis card */}
      <article
        class="relative overflow-hidden rounded-2xl border border-accent/35 bg-surface p-7 shadow-sm sm:p-8"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -right-16 -top-16 h-44 w-44 rounded-full bg-accent-soft opacity-70 blur-2xl"
        >
        </div>
        <div class="relative">
          <span
            class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent"
          >
            {focus.thesis.label} · Featured
          </span>
          <h3 class="mt-4 font-display text-xl leading-snug sm:text-2xl">
            {focus.thesis.title}
          </h3>
          <p class="mt-3 leading-relaxed text-muted">{focus.thesis.blurb}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {
              focus.thesis.tags.map((t) => (
                <li class="rounded-md border border-edge px-2.5 py-1 text-xs font-medium text-muted">
                  {t}
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-xs text-faint">{focus.thesis.note}</p>
        </div>
      </article>

      {/* Frameworks */}
      <div class="rounded-2xl border border-edge bg-surface p-7 sm:p-8">
        <h3 class="font-display text-lg">Frameworks I work with</h3>
        <p class="mt-2 text-sm text-muted">
          The governance vocabulary I'm building fluency in.
        </p>
        <ul class="mt-6 space-y-4">
          {
            focus.frameworks.map((f) => (
              <li class="flex items-center gap-3 text-ink">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                <span class="font-medium">{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
