---
import { getCollection } from "astro:content";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";

const all = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = all.find((p) => p.data.featured);
const rest = all.filter((p) => !p.data.featured);
---

<section id="projects" class="border-t border-edge/60">
  <div class="container-page py-[var(--spacing-section)]">
    <SectionHeading eyebrow="Projects" title="Selected work" />
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">
      A curated few, not everything — each with what it is, the stack, and what
      I took from it.
    </p>

    {/* Featured thesis */}
    {
      featured && (
        <article class="relative mt-10 overflow-hidden rounded-2xl border border-accent/35 bg-surface p-7 shadow-sm sm:p-8">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -right-16 -top-16 h-44 w-44 rounded-full bg-accent-soft opacity-70 blur-2xl"
          />
          <div class="relative grid gap-7 lg:grid-cols-[minmax(0,0.6fr)_minmax(0,0.4fr)] lg:gap-10">
            <div>
              <span class="inline-flex items-center gap-2 rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent">
                Featured · Master's thesis
              </span>
              <h3 class="mt-4 font-display text-xl leading-snug sm:text-2xl">
                {featured.data.title}
              </h3>
              <p class="mt-3 leading-relaxed text-muted">
                {featured.data.summary}
              </p>
            </div>

            <div class="flex flex-col gap-5 lg:border-l lg:border-edge lg:pl-9">
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-faint">
                  Stack
                </p>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {featured.data.stack.map((s) => (
                    <li class="rounded-md border border-edge px-2.5 py-1 text-xs font-medium text-muted">
                      {s}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-wider text-faint">
                  What I learned
                </p>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">
                  {featured.data.learned}
                </p>
              </div>
              {featured.data.repoUrl ? (
                <a
                  href={featured.data.repoUrl}
                  target="_blank"
                  rel="noopener"
                  class="mt-auto inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-strong"
                >
                  <Icon name="github" class="h-4 w-4" /> View repo
                </a>
              ) : (
                <p class="mt-auto text-sm text-faint">Code available on request</p>
              )}
            </div>
          </div>
        </article>
      )
    }

    {/* Curated rest */}
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      {
        rest.map((p) => (
          <article class="flex flex-col rounded-2xl border border-edge bg-surface p-6 transition-colors hover:border-accent/60">
            <h3 class="font-display text-lg leading-snug">{p.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">
              {p.data.summary}
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.data.stack.map((s) => (
                <li class="rounded-md border border-edge px-2.5 py-1 text-xs font-medium text-muted">
                  {s}
                </li>
              ))}
            </ul>
            <p class="mt-4 text-sm leading-relaxed text-muted">
              <span class="font-medium text-faint">Learned — </span>
              {p.data.learned}
            </p>
            {p.data.repoUrl && (
              <a
                href={p.data.repoUrl}
                target="_blank"
                rel="noopener"
                class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-medium text-accent hover:text-accent-strong"
              >
                <Icon name="github" class="h-4 w-4" /> View repo
                <Icon name="arrow" class="h-3.5 w-3.5" />
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
